# ==========================================
# Context Bank Configuration
# ==========================================

# Application Environment (development / production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & JWT Auth
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# For PostgreSQL (production & Docker default):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/context_bank
# For lightweight local development without PostgreSQL running:
# DATABASE_URL=sqlite:///./context_bank.db

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# Streamlit Frontend Service
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Optional AI Services (Gemini)
# If left empty, all core triggers, contexts, versions, packaging, and search work offline!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Semantic Embedding Provider: "tfidf" (default offline zero-dep), "gemini" (requires GEMINI_API_KEY)
EMBEDDING_PROVIDER=tfidf

# Default Admin / Dev User for Initial Seed
DEFAULT_USER_EMAIL=dev@contextbank.local
DEFAULT_USER_PASSWORD=contextbank_dev_password
